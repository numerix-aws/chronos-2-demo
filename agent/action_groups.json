{
  "openapi": "3.0.3",
  "info": {
    "title": "Chronos2 Demo Action Groups",
    "version": "0.1.0",
    "description": "Tool surface for the Numerix × Chronos-2 PoC agent."
  },
  "paths": {
    "/load_data": {
      "post": {
        "operationId": "load_data",
        "summary": "Slice a curated market data panel and stage it in S3.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["session_id", "execution_id"],
                "properties": {
                  "session_id": { "type": "string" },
                  "execution_id": {
                    "type": "string",
                    "description": "Identifier for the validated quantitative run."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Panel ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "execution_id",
                    "spec_hash",
                    "panel_uri",
                    "panel_sha256",
                    "covariates_uri",
                    "covariates_sha256",
                    "regimes_uri",
                    "regimes_sha256",
                    "n_rows",
                    "as_of_date"
                  ],
                  "properties": {
                    "execution_id": { "type": "string" },
                    "spec_hash": { "type": "string" },
                    "panel_uri": { "type": "string", "format": "uri" },
                    "panel_sha256": { "type": "string" },
                    "covariates_uri": { "type": "string", "format": "uri" },
                    "covariates_sha256": { "type": "string" },
                    "regimes_uri": { "type": "string", "format": "uri" },
                    "regimes_sha256": { "type": "string" },
                    "n_rows": { "type": "integer" },
                    "as_of_date": { "type": "string", "format": "date" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/run_baseline_mc": {
      "post": {
        "operationId": "run_baseline_mc",
        "summary": "Launch the parametric Monte Carlo (PCA + factor dynamics) as an async Fargate task. Returns immediately with a task handle; poll with check_baseline_mc.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["execution_id", "panel_uri"],
                "properties": {
                  "execution_id": {
                    "type": "string",
                    "description": "Identifier for the validated quantitative run."
                  },
                  "panel_uri": {
                    "type": "string",
                    "format": "uri",
                    "description": "S3 location of the aligned market history for this run."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fargate task launched",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["execution_id", "spec_hash", "task_arn", "paths_uri"],
                  "properties": {
                    "execution_id": { "type": "string" },
                    "spec_hash": { "type": "string" },
                    "task_arn": { "type": "string" },
                    "paths_uri": { "type": "string", "format": "uri" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" },
          "500": { "description": "Fargate RunTask failed" }
        }
      }
    },
    "/check_baseline_mc": {
      "post": {
        "operationId": "check_baseline_mc",
        "summary": "Poll the launched baseline-MC Fargate task. Call repeatedly until ready is true, then use paths_uri.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["execution_id", "task_arn", "paths_uri"],
                "properties": {
                  "execution_id": {
                    "type": "string",
                    "description": "Identifier for the validated quantitative run."
                  },
                  "task_arn": { "type": "string" },
                  "paths_uri": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["task_status", "ready", "paths_uri"],
                  "properties": {
                    "execution_id": { "type": "string" },
                    "spec_hash": { "type": "string" },
                    "task_status": { "type": "string" },
                    "ready": { "type": "boolean" },
                    "paths_uri": { "type": "string", "format": "uri" },
                    "artifact_uri": { "type": "string", "format": "uri" },
                    "artifact_sha256": { "type": "string" },
                    "artifact_kind": { "type": "string" },
                    "source": { "type": "string" },
                    "scenario_role": { "type": "string" },
                    "producer_version": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" },
          "500": { "description": "Fargate task failed" }
        }
      }
    },
    "/run_chronos2": {
      "post": {
        "operationId": "run_chronos2",
        "summary": "Launch the Chronos-2 augmenting-paths job as an async Fargate task (AutoGluon Cloud endpoint). Returns immediately with a task handle; poll with check_chronos2.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["execution_id", "panel_uri", "covariates_uri"],
                "properties": {
                  "execution_id": {
                    "type": "string",
                    "description": "Identifier for the validated quantitative run."
                  },
                  "panel_uri": {
                    "type": "string",
                    "format": "uri",
                    "description": "S3 location of the aligned market history for this run."
                  },
                  "covariates_uri": {
                    "type": "string",
                    "format": "uri",
                    "description": "S3 location of the aligned conditioning covariates for this run."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fargate task launched; PathSet lands at paths_uri when ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["execution_id", "spec_hash", "task_arn", "paths_uri"],
                  "properties": {
                    "execution_id": { "type": "string" },
                    "spec_hash": { "type": "string" },
                    "task_arn": { "type": "string" },
                    "paths_uri": { "type": "string", "format": "uri" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" },
          "500": { "description": "Fargate RunTask failed" }
        }
      }
    },
    "/check_chronos2": {
      "post": {
        "operationId": "check_chronos2",
        "summary": "Poll the launched Chronos-2 Fargate task. Call repeatedly until ready is true, then use paths_uri.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["execution_id", "task_arn", "paths_uri"],
                "properties": {
                  "execution_id": {
                    "type": "string",
                    "description": "Identifier for the validated quantitative run."
                  },
                  "task_arn": { "type": "string" },
                  "paths_uri": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["task_status", "ready", "paths_uri"],
                  "properties": {
                    "execution_id": { "type": "string" },
                    "spec_hash": { "type": "string" },
                    "task_status": { "type": "string" },
                    "ready": { "type": "boolean" },
                    "paths_uri": { "type": "string", "format": "uri" },
                    "artifact_uri": { "type": "string", "format": "uri" },
                    "artifact_sha256": { "type": "string" },
                    "artifact_kind": { "type": "string" },
                    "source": { "type": "string" },
                    "scenario_role": { "type": "string" },
                    "producer_version": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" },
          "500": { "description": "Fargate task failed" }
        }
      }
    },
    "/blend_paths": {
      "post": {
        "operationId": "blend_paths",
        "summary": "Importance-weight parametric and Chronos-2 PathSets into one blended PathSet.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["execution_id", "parametric_uri", "chronos2_uri"],
                "properties": {
                  "execution_id": {
                    "type": "string",
                    "description": "Identifier for the validated quantitative run."
                  },
                  "parametric_uri": {
                    "type": "string",
                    "format": "uri",
                    "description": "S3 location of the baseline scenario paths for this run."
                  },
                  "chronos2_uri": {
                    "type": "string",
                    "format": "uri",
                    "description": "S3 location of the Chronos-2 scenario paths for this run."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Blended PathSet staged in S3",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "execution_id",
                    "spec_hash",
                    "blended_uri",
                    "blended_sha256",
                    "diagnostics_uri",
                    "diagnostics_sha256"
                  ],
                  "properties": {
                    "execution_id": { "type": "string" },
                    "spec_hash": { "type": "string" },
                    "blended_uri": { "type": "string", "format": "uri" },
                    "blended_sha256": { "type": "string" },
                    "diagnostics_uri": { "type": "string", "format": "uri" },
                    "diagnostics_sha256": { "type": "string" },
                    "diagnostics": { "type": "object" },
                    "w_stress": { "type": "number" },
                    "n_paths": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/price_book": {
      "post": {
        "operationId": "price_book",
        "summary": "Price the demo XCCY book on a PathSet and compute EE/PFE/ES.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["execution_id", "paths_uri"],
                "properties": {
                  "execution_id": {
                    "type": "string",
                    "description": "Identifier for the validated quantitative run."
                  },
                  "paths_uri": {
                    "type": "string",
                    "format": "uri",
                    "description": "S3 location of the scenario paths to price for this run."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exposure metrics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "execution_id",
                    "spec_hash",
                    "scenario_role",
                    "source",
                    "paths_uri",
                    "paths_sha256",
                    "ee",
                    "pfe_975",
                    "es_975",
                    "dates",
                    "terminal",
                    "metrics_uri",
                    "metrics_sha256"
                  ],
                  "properties": {
                    "execution_id": { "type": "string" },
                    "spec_hash": { "type": "string" },
                    "scenario_role": { "type": "string" },
                    "source": { "type": "string" },
                    "paths_uri": { "type": "string", "format": "uri" },
                    "paths_sha256": { "type": "string" },
                    "ee": { "type": "array", "items": { "type": "number" } },
                    "pfe_975": { "type": "array", "items": { "type": "number" } },
                    "es_975": { "type": "array", "items": { "type": "number" } },
                    "dates": { "type": "array", "items": { "type": "string", "format": "date" } },
                    "terminal": {
                      "type": "object",
                      "required": ["date", "ee", "pfe_975", "es_975"],
                      "properties": {
                        "date": { "type": "string", "format": "date" },
                        "ee": { "type": "number" },
                        "pfe_975": { "type": "number" },
                        "es_975": { "type": "number" }
                      }
                    },
                    "metrics_uri": { "type": "string", "format": "uri" },
                    "metrics_sha256": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/plot": {
      "post": {
        "operationId": "plot",
        "summary": "Render a chart (pfe_overlay | path_fan | regime_ribbon) and return a presigned PNG URL.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["execution_id", "spec"],
                "properties": {
                  "execution_id": {
                    "type": "string",
                    "description": "Identifier for the validated quantitative run."
                  },
                  "spec": {
                    "type": "string",
                    "enum": ["pfe_overlay", "path_fan", "regime_ribbon"],
                    "description": "Chart type inferred from the requested visual comparison."
                  },
                  "baseline_uri": { "type": "string", "format": "uri" },
                  "augmented_uri": { "type": "string", "format": "uri" },
                  "paths_uri": { "type": "string", "format": "uri" },
                  "regimes_uri": { "type": "string", "format": "uri" },
                  "series": { "type": "string" },
                  "title": { "type": "string" }
                },
                "oneOf": [
                  {
                    "properties": { "spec": { "enum": ["pfe_overlay"] } },
                    "required": ["baseline_uri", "augmented_uri"]
                  },
                  {
                    "properties": { "spec": { "enum": ["path_fan"] } },
                    "required": ["paths_uri", "series"]
                  },
                  {
                    "properties": { "spec": { "enum": ["regime_ribbon"] } },
                    "required": ["regimes_uri"]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presigned PNG URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "execution_id",
                    "spec_hash",
                    "plot_role",
                    "image_s3_uri",
                    "image_uri",
                    "image_sha256"
                  ],
                  "properties": {
                    "execution_id": { "type": "string" },
                    "spec_hash": { "type": "string" },
                    "plot_role": { "type": "string" },
                    "image_s3_uri": { "type": "string", "format": "uri" },
                    "image_uri": { "type": "string", "format": "uri" },
                    "image_sha256": { "type": "string" },
                    "spec": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/lookup_use_case": {
      "post": {
        "operationId": "lookup_use_case",
        "summary": "Fetch a curated brief on an adjacent Chronos-2 use case.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Brief content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Returns topics for catalog discovery, or topic, summary, and markdown for a requested brief.",
                  "properties": {
                    "topics": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "topic": { "type": "string" },
                    "summary": { "type": "string" },
                    "markdown": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "description": "Topic not in catalog" }
        }
      }
    }
  }
}
