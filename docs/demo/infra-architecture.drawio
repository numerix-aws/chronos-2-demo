        <mxCell id="lb-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="1" vertex="1" parent="legend-container"><mxGeometry x="0" y="0" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="lt-1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" value="&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Load SPA&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Analyst loads the Cloudscape SPA from Amplify Hosting.&lt;/span&gt;" vertex="1" parent="legend-container"><mxGeometry x="50" y="0" width="510" height="38" as="geometry" /></mxCell>

        <mxCell id="lb-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="2" vertex="1" parent="legend-container"><mxGeometry x="0" y="55" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="lt-2" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" value="&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Open SSE stream&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;SPA opens an SSE stream via fetch + ReadableStream (x-api-key header).&lt;/span&gt;" vertex="1" parent="legend-container"><mxGeometry x="50" y="55" width="510" height="38" as="geometry" /></mxCell>

        <mxCell id="lb-3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="3" vertex="1" parent="legend-container"><mxGeometry x="0" y="110" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="lt-3" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" value="&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Secured streaming edge (CloudFront OAC + WAF)&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;CloudFront signs SigV4 (OAC) to the SSE relay Function URL; WAF inspects.&lt;/span&gt;" vertex="1" parent="legend-container"><mxGeometry x="50" y="110" width="510" height="48" as="geometry" /></mxCell>

        <mxCell id="lb-4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="4" vertex="1" parent="legend-container"><mxGeometry x="0" y="175" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="lt-4" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" value="&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;REST API (x-api-key authorizer)&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;POST /invoke and /sessions through API Gateway behind the x-api-key authorizer.&lt;/span&gt;" vertex="1" parent="legend-container"><mxGeometry x="50" y="175" width="510" height="48" as="geometry" /></mxCell>

        <mxCell id="lb-5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="5" vertex="1" parent="legend-container"><mxGeometry x="0" y="240" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="lt-5" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" value="&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Session + invoke&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;API Gateway proxies to the invoke / sessions Lambda.&lt;/span&gt;" vertex="1" parent="legend-container"><mxGeometry x="50" y="240" width="510" height="38" as="geometry" /></mxCell>

        <mxCell id="lb-6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="6" vertex="1" parent="legend-container"><mxGeometry x="0" y="295" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="lt-6" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" value="&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Invoke AgentCore Runtime&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;SSE relay and invoke Lambdas call bedrock-agentcore:InvokeAgentRuntime (qualifier=live).&lt;/span&gt;" vertex="1" parent="legend-container"><mxGeometry x="50" y="295" width="510" height="48" as="geometry" /></mxCell>

        <mxCell id="lb-7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="7" vertex="1" parent="legend-container"><mxGeometry x="0" y="360" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="lt-7" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" value="&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;MCP tool calls (9 tools via Gateway)&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Strands agent calls the 9 tool-handler Lambdas as MCP tools through AgentCore Gateway.&lt;/span&gt;" vertex="1" parent="legend-container"><mxGeometry x="50" y="360" width="510" height="48" as="geometry" /></mxCell>

        <mxCell id="lb-8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="8" vertex="1" parent="legend-container"><mxGeometry x="0" y="425" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="lt-8" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" value="&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Async Fargate compute (baseline MC + Chronos-2)&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Tool Lambdas launch run_baseline_mc and run_chronos2 Fargate tasks via ecs:RunTask.&lt;/span&gt;" vertex="1" parent="legend-container"><mxGeometry x="50" y="425" width="510" height="48" as="geometry" /></mxCell>

        <mxCell id="lb-9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="9" vertex="1" parent="legend-container"><mxGeometry x="0" y="490" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="lt-9" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" value="&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Chronos-2 inference (SageMaker quantiles)&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;run_chronos2 calls the SageMaker endpoint (sagemaker:InvokeEndpoint) for quantiles.&lt;/span&gt;" vertex="1" parent="legend-container"><mxGeometry x="50" y="490" width="510" height="48" as="geometry" /></mxCell>

        <mxCell id="lb-10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="10" vertex="1" parent="legend-container"><mxGeometry x="0" y="555" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="lt-10" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" value="&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Persist paths/plots/sessions (S3 + DynamoDB)&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Fargate tasks write paths and tool Lambdas write plots to S3; sessions persist to DynamoDB.&lt;/span&gt;" vertex="1" parent="legend-container"><mxGeometry x="50" y="555" width="510" height="48" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
